# ===== SIGNSAFE ENVIRONMENT CONFIGURATION =====

# --- Supabase ---
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- Google Gemini AI ---
# Get API key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here
# Fallback key (optional, for 503 resilience - use a different project/billing account)
GEMINI_FALLBACK_API_KEY=your-fallback-gemini-key-here

# --- Site Configuration ---
NEXT_PUBLIC_SITE_URL=https://signsafe.app
NEXT_PUBLIC_GOOGLE_VERIFICATION=your-google-verification-code

# --- Optional: Analytics & Monitoring ---
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
